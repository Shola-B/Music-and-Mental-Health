genre_avg <- genre_coords %>%
group_by(genre) %>%
summarise(
Dim1 = mean(Dim1, na.rm = TRUE),
Dim2 = mean(Dim2, na.rm = TRUE),
Dim3 = mean(Dim3, na.rm = TRUE),
Dim4 = mean(Dim4, na.rm = TRUE),
Dim5 = mean(Dim5, na.rm = TRUE)
)
# Compute distances between genres using the first 5 dimensions
dist_mat <- dist(genre_avg[, c("Dim1", "Dim2", "Dim3", "Dim4", "Dim5")])
# Perform hierarchical clustering
hc <- hclust(dist_mat, method = "ward.D2")
# Plot dendrogram
plot(hc, main = "Genre Clustering (Hierarchical)")
# Ran multiple tests with different k values (bc clustering was weak)
# found that cutting the tree into 5 groups made the most sense
genre_avg$group <- cutree(hc, k = 5)
# Step 11: Final output
genre_final <- genre_avg %>%
select(genre, group)
genre_final
# Step 12: Check group sizes
table(genre_final$group)
# Step 13: Add readable labels
genre_final$group_name <- case_when(
genre_final$group == 1 ~ "Group 1",
genre_final$group == 2 ~ "Group 2",
genre_final$group == 3 ~ "Group 3",
genre_final$group == 4 ~ "Group 4",
genre_final$group == 5 ~ "Group 5"
)
genre_final
# Make a clean plot with one point per genre,
# so it's much easier to interpret than the full CA plot
plot(genre_avg$Dim1, genre_avg$Dim2,
col = genre_avg$group,
pch = 19,
xlab = "Dimension 1",
ylab = "Dimension 2",
main = "Genre Clusters (Clean View)")
text(genre_avg$Dim1, genre_avg$Dim2,
labels = genre_avg$genre,
pos = 3,
cex = 0.8)
# Inspect genres by cluster
genre_final %>%
arrange(group, genre)
# View genres grouped by cluster
genre_final %>%
group_by(group) %>%
summarise(genres = paste(genre, collapse = ", "))
split(genre_final$genre, genre_final$group)
# Convert frequency categories to numeric
freq_data <- my_data_testing %>%
select(starts_with("Frequency_")) %>%
mutate(across(everything(), ~ case_when(
. == "Never" ~ 0,
. == "Rarely" ~ 1,
. == "Sometimes" ~ 2,
. == "Very frequently" ~ 3,
TRUE ~ NA_real_
)))
# Map clustered genres to their frequency column names
genre_map <- genre_final %>%
mutate(freq_col = paste0("Frequency_", genre))
# Compute average score per group for each person
group_scores <- sapply(sort(unique(genre_map$group)), function(g) {
cols <- genre_map$freq_col[genre_map$group == g]
cols <- cols[cols %in% names(freq_data)]
rowMeans(freq_data[, cols, drop = FALSE], na.rm = TRUE)
})
# Assign each person to the group they listen to most
my_data_testing$GenreGroup <- apply(group_scores, 1, function(x) {
if (all(is.na(x))) NA else which.max(x)
})
# Convert to factor
my_data_testing$GenreGroup <- as.factor(my_data_testing$GenreGroup)
# Check result
# my_data_testing
write.csv(my_data_testing, "data/my_data_testing_intermediary.csv",
row.names = FALSE)
my_data_testing <- read.csv("data/my_data_testing_intermediary.csv", header = TRUE)
my_data_testing_clean <- my_data_testing %>%
mutate(
# Rename columns to clean names
Age = Age,
HoursPerDay = Hoursperday,
WhileWorking = Whileworking,
StreamingService = Primarystreamingservice,
BPM = BPM,
# Add your already-created variables
ConsolidatedGenres = GenreGroup,
ConsolidatedMentalHealthScore_PC1 = MentalHealthScore_PC1,
ConsolidatedMentalHealthScore_PC2 = MentalHealthScore_PC2,
) %>%
# Select the columns we want to keep
select(
Age,
HoursPerDay,
WhileWorking,
StreamingService,
BPM,
ConsolidatedGenres,
ConsolidatedMentalHealthScore_PC1,
ConsolidatedMentalHealthScore_PC2
)
write.csv(my_data_testing_clean, "data/my_data_testing_clean.csv", row.names = FALSE)
my_data_testing_clean <- read.csv("data/my_data_testing_clean.csv", header = TRUE)
#Mental Health Scores vs Music Listening Hours
model1 <- lm(
ConsolidatedMentalHealthScore_PC1 ~ HoursPerDay, data = my_data_testing_clean
)
# View summaries/plots
summary(model1)
plot(model1, which = 1,
labels.id = my_data_testing_clean$HoursPerDay)
bptest(model1)
model1_robustse <- sqrt(diag(vcovHC(model1, type="HC3")))
#Mental Health Scores vs BPM
model1b <- lm(
ConsolidatedMentalHealthScore_PC1 ~ BPM, data = my_data_testing_clean
)
# View summaries/plots
summary(model1b)
plot(model1b, which = 1,
labels.id = my_data_testing_clean$HoursPerDay)
model1b_robustse <- sqrt(diag(vcovHC(model1b, type="HC3")))
#Mental Health Scores vs Age
model2 <- lm(
ConsolidatedMentalHealthScore_PC1 ~ Age, data = my_data_testing_clean
)
# View summaries/plots
summary(model2)
plot(model2, which = 1,
labels.id = my_data_testing_clean$HoursPerDay)
model2_robustse <- sqrt(diag(vcovHC(model2, type="HC3")))
stargazer(model1, model1b, model2,
type="latex",
se = list(model1_robustse, model1b_robustse, model2_robustse),
star.cutoffs = c(0.05, 0.01, 0.001, NA),
notes = "Significant at *p < 0.05, **p < 0.01, ***p < 0.001",
title = "Regression Results for Mental Health Scores (Simple Models)",
dep.var.labels = c("Mental Health Score (PC1)"),
covariate.labels = c("Hours per Day"),
notes.append = FALSE,
header = FALSE
)
# Make sure genre is categorical
my_data_testing_clean$ConsolidatedGenres <- as.factor(
my_data_testing_clean$ConsolidatedGenres)
#Mental Health Scores vs Genre groups
model3 <- lm(
ConsolidatedMentalHealthScore_PC1 ~ ConsolidatedGenres,
data = my_data_testing_clean
)
# View summaries/plots
summary(model3)
plot(model3, which = 1,
labels.id = my_data_testing_clean$HoursPerDay)
model3_robustse <- sqrt(diag(vcovHC(model3, type="HC3")))
#Mental Health Scores vs Genre groups
model4 <- lm(
ConsolidatedMentalHealthScore_PC2 ~ ConsolidatedGenres,
data = my_data_testing_clean
)
# View summaries/plots
summary(model4)
plot(model4, which = 1,
labels.id = my_data_testing_clean$HoursPerDay)
model4_robustse <- sqrt(diag(vcovHC(model4, type="HC3")))
## Models with Age and Genre
# 1. PCA1 + Genre_Score + Age
model_a1 <- lm(
ConsolidatedMentalHealthScore_PC1 ~ ConsolidatedGenres + Age,
data = my_data_testing_clean
)
model_a1_robustse <- sqrt(diag(vcovHC(model_a1, type="HC3")))
# 2. PCA2 + Genre_Score + Age
model_a2 <- lm(
ConsolidatedMentalHealthScore_PC2 ~ ConsolidatedGenres + Age,
data = my_data_testing_clean
)
model_a2_robustse <- sqrt(diag(vcovHC(model_a2, type="HC3")))
# 3. PCA1 + age
model_b1 <- lm(
ConsolidatedMentalHealthScore_PC1 ~ Age,
data = my_data_testing_clean
)
model_b1_robustse <- sqrt(diag(vcovHC(model_b1, type="HC3")))
# 4. PCA2 + age
model_b2 <- lm(
ConsolidatedMentalHealthScore_PC2 ~ Age,
data = my_data_testing_clean
)
model_b2_robustse <- sqrt(diag(vcovHC(model_b2, type="HC3")))
# View summaries/plots
summary(model_a1)
plot(model_a1, which = 1)
summary(model_a2)
plot(model_a2, which = 1)
summary(model_b1)
plot(model_b1, which = 1)
summary(model_b2)
plot(model_b2, which = 1)
## Models with conditional Age / BPM
# 1. PCA1 + Genre_Score + Age + BPM
model1c <- lm(
ConsolidatedMentalHealthScore_PC1 ~ ConsolidatedGenres + Age + HoursPerDay,
data = my_data_testing_clean
)
model1c_robustse <- sqrt(diag(vcovHC(model1c, type="HC3")))
# 2. PCA2 + Genre_Score + Age + BPM
model2c <- lm(
ConsolidatedMentalHealthScore_PC1 ~ ConsolidatedGenres + Age + HoursPerDay + BPM,
data = my_data_testing_clean
)
model2c_robustse <- sqrt(diag(vcovHC(model2c, type="HC3")))
# 3. PCA1 + BPM
model3c <- lm(
ConsolidatedMentalHealthScore_PC1 ~ Age + I(HoursPerDay^0.5),
data = my_data_testing_clean
)
model3c_robustse <- sqrt(diag(vcovHC(model3c, type="HC3")))
# 4. PCA2 + BPM
model4c <- lm(
ConsolidatedMentalHealthScore_PC2 ~ HoursPerDay,
data = my_data_testing_clean
)
model4c_robustse <- sqrt(diag(vcovHC(model4c, type="HC3")))
# 5. PCA1 + Genre_Score + BPM
model5c <- lm(
ConsolidatedMentalHealthScore_PC1 ~ ConsolidatedGenres + BPM,
data = my_data_testing_clean
)
model5c_robustse <- sqrt(diag(vcovHC(model5c, type="HC3")))
# 6. PCA2 + Genre_Score + BPM
model6c <- lm(
ConsolidatedMentalHealthScore_PC2 ~ ConsolidatedGenres + BPM,
data = my_data_testing_clean
)
model6c_robustse <- sqrt(diag(vcovHC(model6c, type="HC3")))
# 7. PCA1 + Age + HoursPerDay^2
model7c <- lm(
ConsolidatedMentalHealthScore_PC1 ~ Age + I(HoursPerDay^2),
data = my_data_testing_clean
)
model7c_robustse <- sqrt(diag(vcovHC(model7c, type="HC3")))
# 8. PCA1 + Age + ln(HoursPerDay)
model8c <- lm(
ConsolidatedMentalHealthScore_PC1 ~ Age + I(HoursPerDay^.5),
data = my_data_testing_clean
)
model8c_robustse <- sqrt(diag(vcovHC(model8c, type="HC3")))
# View summaries/plots
summary(model1c)
plot(model1c, which = 1)
summary(model2c)
plot(model2c, which = 1)
summary(model3c)
plot(model3c, which = 1)
summary(model4c)
plot(model4c, which = 1)
summary(model5c)
plot(model5c, which = 1)
summary(model6c)
plot(model6c, which = 1)
summary(model7c)
plot(model7c, which = 1)
summary(model8c)
plot(model8c, which = 1)
stargazer(model3, model_a1, model1c, model2c,
type="latex",
se = list(model3_robustse, model_a1_robustse, model1c_robustse, model2c_robustse),
star.cutoffs = c(0.05, 0.01, 0.001),
notes = "Significant at *p < 0.05, **p < 0.01, ***p < 0.001",
title = "Regression Results for Mental Health Scores (Multivariate Models)",
dep.var.labels = c("Mental Health Score (PC1)"),
covariate.labels = c(
"Country", "Rap/EDM/Kpop", "Gospel", "Jazz/Latin", "Age", "Hours per Day"),
notes.append = FALSE,
header = FALSE
)
modelx <- lm(
ConsolidatedMentalHealthScore_PC1 ~ Age +log(HoursPerDay + 1),
